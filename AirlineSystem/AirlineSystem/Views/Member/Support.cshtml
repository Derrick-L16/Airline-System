@model List<ChatMessage>
@{
    ViewBag.Title = "Customer Support";
    var member = ViewBag.Member as Member;
}

<div class="chat-container">
    <div class="chat-header">
        <div>
            <div class="title">✈️ DreaméJet Support Team</div>
            <small style="opacity: 0.85;">All available admins are here to help you</small>
        </div>
        <div class="status-badge">
            <span class="status-dot"></span> Online
        </div>
    </div>

    <div class="chat-messages" id="chatMessages">
        @if (Model == null || Model.Count == 0)
        {
            <div class="empty-chat" id="emptyPlaceholder">
                <p style="font-size: 28px; margin: 0 0 10px;">💬</p>
                <b>Welcome to DreaméJet Support!</b>
                <p>Send a message below and our support team will reply shortly.</p>
            </div>
        }
        else
        {
            @foreach (var msg in Model)
            {
                <div class="chat-msg @(msg.IsFromAdmin ? "admin" : "member")">
                    <div class="msg-text">@msg.Message</div>
                    <div class="msg-meta">
                        <span class="sender-tag">@(msg.IsFromAdmin ? "Staff (" + msg.SenderName + ")" : "You")</span>
                        <span>@msg.SentAt.ToString("g")</span>
                    </div>
                </div>
            }
        }
    </div>

    <div class="chat-input-bar">
        <input type="text" id="messageInput" placeholder="Type your query or message here..." autocomplete="off" maxlength="2000" />
        <button type="button" id="sendBtn">Send</button>
    </div>
</div>

<style>
    .chat-container {
        max-width: 820px;
        margin: 15px auto;
        background: #fff;
        border: 1px solid #ccc;
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 600px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.08);
    }
    .chat-header {
        background: #2b3a4a;
        color: #fff;
        padding: 14px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .chat-header .title {
        font-weight: 700;
        font-size: 17px;
    }
    .chat-header .status-badge {
        font-size: 13px;
        background: rgba(46, 204, 113, 0.2);
        color: #2ecc71;
        border: 1px solid #2ecc71;
        padding: 3px 10px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .status-dot {
        width: 8px;
        height: 8px;
        background: #2ecc71;
        border-radius: 50%;
        display: inline-block;
    }
    .chat-messages {
        flex: 1;
        padding: 20px;
        overflow-y: auto;
        background: #f7f9fa;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .chat-msg {
        max-width: 70%;
        padding: 10px 14px;
        border-radius: 12px;
        font-size: 15px;
        line-height: 1.4;
        word-break: break-word;
    }
    .chat-msg.member {
        align-self: flex-end;
        background: #007bff;
        color: #fff;
        border-bottom-right-radius: 2px;
    }
    .chat-msg.admin {
        align-self: flex-start;
        background: #e9ecef;
        color: #212529;
        border-bottom-left-radius: 2px;
        border: 1px solid #dee2e6;
    }
    .msg-meta {
        font-size: 11px;
        margin-top: 5px;
        opacity: 0.85;
        display: flex;
        gap: 10px;
        justify-content: flex-end;
    }
    .chat-msg.admin .msg-meta {
        justify-content: flex-start;
        color: #555;
    }
    .sender-tag {
        font-weight: bold;
    }
    .chat-input-bar {
        padding: 12px 16px;
        background: #fff;
        border-top: 1px solid #ddd;
        display: flex;
        gap: 10px;
    }
    .chat-input-bar input {
        flex: 1;
        padding: 10px 14px;
        border: 1px solid #ccc;
        border-radius: 6px;
        outline: none;
    }
    .chat-input-bar input:focus {
        border-color: #007bff;
    }
    .chat-input-bar button {
        background: #007bff;
        color: #fff;
        border: none;
        padding: 0 24px;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }
    .chat-input-bar button:hover {
        background: #0056b3;
    }
    .empty-chat {
        margin: auto;
        text-align: center;
        color: #888;
    }
</style>

@section foot {
    <script src="/js/signalr.min.js"></script>
    <script>
        const chatBox = document.getElementById("chatMessages");
        const msgInput = document.getElementById("messageInput");
        const sendBtn = document.getElementById("sendBtn");
        const emptyPlaceholder = document.getElementById("emptyPlaceholder");

        function scrollToBottom() {
            chatBox.scrollTop = chatBox.scrollHeight;
        }
        scrollToBottom();

        // 1. Establish SignalR connection
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();

        // 2. Receive incoming message in real-time
        connection.on("ReceiveMessage", function (msg) {
            if (emptyPlaceholder) {
                emptyPlaceholder.remove();
            }

            const isMe = !msg.isFromAdmin;
            const bubble = document.createElement("div");
            bubble.className = "chat-msg " + (isMe ? "member" : "admin");

            const textDiv = document.createElement("div");
            textDiv.className = "msg-text";
            textDiv.textContent = msg.message;

            const metaDiv = document.createElement("div");
            metaDiv.className = "msg-meta";

            const senderSpan = document.createElement("span");
            senderSpan.className = "sender-tag";
            senderSpan.textContent = isMe ? "You" : "Staff (" + msg.senderName + ")";

            const timeSpan = document.createElement("span");
            timeSpan.textContent = msg.sentAt;

            metaDiv.appendChild(senderSpan);
            metaDiv.appendChild(timeSpan);

            bubble.appendChild(textDiv);
            bubble.appendChild(metaDiv);

            chatBox.appendChild(bubble);
            scrollToBottom();
        });

        // 3. Connect to hub
        connection.start().then(function () {
            console.log("Connected to DreaméJet ChatHub");
        }).catch(function (err) {
            console.error("SignalR Connection Error: ", err.toString());
        });

        // 4. Send message handler
        function sendMessage() {
            const text = msgInput.value.trim();
            if (!text) return;

            connection.invoke("SendMessageToSupport", text).then(function () {
                msgInput.value = "";
                msgInput.focus();
            }).catch(function (err) {
                console.error("Send Error: ", err.toString());
                alert("Failed to send message: " + err.toString());
            });
        }

        sendBtn.addEventListener("click", sendMessage);
        msgInput.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                sendMessage();
            }
        });
    </script>
}
