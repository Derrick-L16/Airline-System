@model SelectSeatVM
@{ ViewBag.Title = "Select Your Seats"; var leftSeats = Model.Seats.Where(s => s.SeatNumber.EndsWith("1")); var rightSeats = Model.Seats.Where(s => s.SeatNumber.EndsWith("2")); }
<div class="container mt-5" id="booking-step">
    <h2>@Model.Flight.FlightCompany.CompanyName @Model.Flight.FlightNumber</h2>
    <p>@Model.Flight.DepartureAirport.AirportName → @Model.Flight.ArrivalAirport.AirportName</p>
    <p>Select <strong>@Model.Pax seat@(Model.Pax > 1 ? "s" : "")</strong> for @Model.Pax passenger@(Model.Pax > 1 ? "s" : "").</p>
    <p class="seat-legend"><span class="available-key"></span> Available <span class="unavailable-key"></span> Unavailable</p>
    <form asp-action="SelectMeals" method="post" data-ajax="true" data-ajax-update="#booking-step" data-ajax-mode="replace">
        @Html.AntiForgeryToken()
        <input type="hidden" name="flightId" value="@Model.Flight.FlightId" /><input type="hidden" name="pax" value="@Model.Pax" /><input type="hidden" id="selected-seat-ids" name="selectedSeatIds" />
        <div class="aircraft"><div class="cockpit">Front of aircraft</div><div class="seat-map">
            <div class="seat-column">@foreach (var seat in leftSeats) { if (seat.SeatAvailability) { <button type="button" class="seat available" data-id="@seat.SeatId">@seat.SeatNumber</button> } else { <button type="button" class="seat unavailable" disabled>@seat.SeatNumber</button> } }</div>
            <div class="aisle">AISLE</div>
            <div class="seat-column">@foreach (var seat in rightSeats) { if (seat.SeatAvailability) { <button type="button" class="seat available" data-id="@seat.SeatId">@seat.SeatNumber</button> } else { <button type="button" class="seat unavailable" disabled>@seat.SeatNumber</button> } }</div>
        </div></div>
        <p id="selected-seat" class="mt-3">Select @Model.Pax seat@(Model.Pax > 1 ? "s" : "") to continue.</p>
        <button type="submit" id="continue-booking" class="btn btn-primary" disabled>Continue Booking</button><a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
@section head { <style>
    .aircraft{max-width:360px;margin:1rem 0;padding:1rem;border:2px solid #777;border-radius:80px 80px 20px 20px}.cockpit{text-align:center;font-weight:bold;margin-bottom:1rem}.seat-map{display:grid;grid-template-columns:1fr 64px 1fr;gap:1rem}.seat-column{display:flex;flex-direction:column;gap:.75rem}.aisle{display:flex;align-items:center;justify-content:center;color:#777;font-size:.75rem;writing-mode:vertical-rl}.seat{min-height:46px;border:2px solid #333;border-radius:8px;font-weight:bold}.seat.available{background:#d9f7df;cursor:pointer}.seat.available:hover,.seat.selected{background:#2f9e44;color:#fff}.seat.unavailable{background:#bdbdbd;color:#666;border-color:#999;cursor:not-allowed}.available-key,.unavailable-key{display:inline-block;width:14px;height:14px;margin:0 .35rem 0 1rem;vertical-align:middle;border:1px solid #555}.available-key{background:#d9f7df}.unavailable-key{background:#bdbdbd}
</style> }
@section foot { <script>
    const maximumSeats=@Model.Pax,selected=[],selectedInput=document.getElementById('selected-seat-ids'),message=document.getElementById('selected-seat'),continueButton=document.getElementById('continue-booking');
    document.querySelectorAll('.seat.available').forEach(seat=>seat.addEventListener('click',()=>{const id=seat.dataset.id,position=selected.indexOf(id);if(position>=0){selected.splice(position,1);seat.classList.remove('selected')}else if(selected.length<maximumSeats){selected.push(id);seat.classList.add('selected')}else{message.textContent=`You can select only ${maximumSeats} seat(s).`;return}selectedInput.value=selected.join(',');message.textContent=`${selected.length} of ${maximumSeats} seat(s) selected.`;continueButton.disabled=selected.length!==maximumSeats;}));
</script> }
