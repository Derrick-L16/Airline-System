@model List<Booking>
@{
    ViewBag.Title = "My Bookings & Orders";
}

<div class="orders-container" style="max-width: 920px; margin: 20px auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; border-bottom: 2px solid #2b3a4a; padding-bottom: 12px;">
        <div>
            <h2 style="margin: 0; color: #2b3a4a;">📋 My Flight Bookings</h2>
            <small style="color: #666;">View and manage your confirmed flight tickets and itineraries</small>
        </div>
        <a href="/" style="background: #007bff; color: #fff; padding: 10px 18px; border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 14px;">
            + Book Another Flight
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div style="background: #fff; border: 1px solid #ddd; border-radius: 8px; padding: 50px 20px; text-align: center;">
            <div style="font-size: 48px; margin-bottom: 15px;">✈️</div>
            <h3 style="margin: 0 0 8px; color: #333;">No Bookings Found</h3>
            <p style="color: #777; margin-bottom: 20px;">You haven't booked any flights yet. Start exploring destinations today!</p>
            <a href="/" style="background: #28a745; color: #fff; padding: 12px 24px; border-radius: 6px; text-decoration: none; font-weight: bold;">
                Search Flights Now
            </a>
        </div>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 20px;">
            @foreach (var b in Model)
            {
                <div class="booking-card" style="background: #fff; border: 1px solid #ddd; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
                    <!-- Header -->
                    <div style="background: #f8f9fa; padding: 12px 20px; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <span style="font-size: 12px; color: #888; text-transform: uppercase;">Reference:</span>
                            <strong style="font-size: 16px; color: #2b3a4a; letter-spacing: 0.5px;">@b.BookingReference</strong>
                            <span style="font-size: 12px; color: #aaa;">&middot; Booked on @b.BookingDate.ToString("dd MMM yyyy")</span>
                        </div>
                        <span style="background: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9; padding: 3px 10px; border-radius: 12px; font-weight: bold; font-size: 12px;">
                            ● @b.BookingStatus
                        </span>
                    </div>

                    <!-- Body -->
                    <div style="padding: 20px;">
                        <div style="display: grid; grid-template-columns: 1fr auto 1fr; gap: 15px; align-items: center; margin-bottom: 18px;">
                            <div>
                                <div style="font-size: 12px; color: #888; text-transform: uppercase;">Departure</div>
                                <strong style="font-size: 16px; color: #222;">@b.Flight.DepartureAirport.AirportName</strong>
                                <div style="font-size: 14px; color: #007bff; font-weight: bold; margin-top: 3px;">
                                    @b.Flight.DepartureTime.ToString("ddd, dd MMM yyyy, h:mm tt")
                                </div>
                            </div>

                            <div style="font-size: 20px; color: #bbb;">&rarr;</div>

                            <div style="text-align: right;">
                                <div style="font-size: 12px; color: #888; text-transform: uppercase;">Arrival</div>
                                <strong style="font-size: 16px; color: #222;">@b.Flight.ArrivalAirport.AirportName</strong>
                                <div style="font-size: 14px; color: #28a745; font-weight: bold; margin-top: 3px;">
                                    @b.Flight.ArrivalTime.ToString("ddd, dd MMM yyyy, h:mm tt")
                                </div>
                            </div>
                        </div>

                        <!-- Passenger & Seat Summary -->
                        <div style="background: #fdfdfd; border: 1px solid #eee; border-radius: 6px; padding: 12px 16px; margin-bottom: 15px;">
                            <div style="font-size: 13px; font-weight: bold; color: #444; margin-bottom: 8px;">
                                Flight: @b.Flight.FlightCompany.CompanyName (@b.Flight.FlightNumber) &middot; @b.BookingPassengers.Count Passenger(s)
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 6px;">
                                @foreach (var bp in b.BookingPassengers)
                                {
                                    <div style="display: flex; justify-content: space-between; font-size: 13px; color: #555;">
                                        <span>
                                            👤 <strong>@bp.Passenger.Name</strong> (Seat: <strong style="color: #2b3a4a;">@bp.Seat.SeatNumber</strong>)
                                            <span style="color: #888;">&middot; Meal: @(bp.Meal != null ? bp.Meal.MealName : "None")</span>
                                        </span>
                                        <span>RM @bp.PassengerFare.ToString("N2")</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Footer / Payment -->
                        <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f0f0f0; padding-top: 12px; font-size: 13px;">
                            <span style="color: #666;">
                                Paid with <strong>@(b.Payment?.PaymentMethod ?? "Stripe")</strong> on @(b.Payment?.PaymentDate.ToString("dd MMM yyyy") ?? b.BookingDate.ToString("dd MMM yyyy"))
                            </span>
                            <div style="font-size: 16px; color: #2b3a4a;">
                                Total: <strong style="color: #28a745; font-size: 18px;">RM @(b.Payment?.Amount.ToString("N2") ?? "0.00")</strong>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
