@{
    ViewBag.Title = "Find Your Flight";
}

<div class="container mt-5">

    <p>Search for available flights to your destination.</p>

    <form asp-controller="Home"
          asp-action="SearchFlights"
          method="get">

        <div class="mb-3">
            <label>Departure Country</label>
            <input type="text"
                   name="departureCountry"
                   class="form-control"
                   placeholder="e.g. Malaysia"
                   required />
        </div>

        <div class="mb-3">
            <label>Destination</label>
            <input type="text"
                   name="destination"
                   class="form-control"
                   placeholder="e.g. Japan"
                   required />
        </div>

        <div class="mb-3">
            <label>Travel Date</label>
            <input type="date"
                   name="travelDate"
                   class="form-control"
                   required />
        </div>

        <div class="mb-3">
            <label>Number of Passengers</label>
            <input type="number"
                   name="pax"
                   class="form-control"
                   min="1"
                   max="9"
                   value="1"
                   required />
        </div>

        <button type="submit" class="btn btn-primary">
            Search Flights
        </button>

    </form>

</div>
