@model MealSelectionVM
<div class="container mt-4">
    <div class="card p-4 shadow-sm" style="max-width: 780px; margin: 0 auto; background: #fff; border: 1px solid #ccc; border-radius: 8px;">
        <div style="border-bottom: 2px solid #2b3a4a; padding-bottom: 12px; margin-bottom: 20px;">
            <h2 style="margin: 0; color: #2b3a4a;">🍽️ Select In-Flight Meal</h2>
            <div style="font-size: 15px; color: #555; margin-top: 6px;">
                <strong>@Model.Flight.FlightCompany.CompanyName @Model.Flight.FlightNumber</strong> &middot; 
                @Model.Flight.DepartureAirport.AirportName &rarr; @Model.Flight.ArrivalAirport.AirportName
            </div>
            <div style="margin-top: 8px; display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                <span style="background: #e3f2fd; color: #0d47a1; padding: 4px 10px; border-radius: 4px; font-weight: bold; font-size: 13px;">
                    Seats: @string.Join(", ", Model.SelectedSeats.Select(s => s.SeatNumber))
                </span>
                <span style="background: #e8f5e9; color: #2e7d32; padding: 4px 10px; border-radius: 4px; font-weight: bold; font-size: 13px;">
                    Passengers: @Model.Pax
                </span>
            </div>
        </div>

        <p style="color: #666; font-size: 14px; margin-bottom: 15px;">Choose a meal separately for each passenger.</p>

        <form asp-action="CheckoutPassengerDetails" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="flightId" value="@Model.Flight.FlightId" />
            <input type="hidden" name="pax" value="@Model.Pax" />
            <input type="hidden" name="selectedSeatIds" value="@Model.SelectedSeatIds" />

            @for (var i = 0; i < Model.Passengers.Count; i++)
            {
                <div style="margin-bottom:18px;padding:14px;border:1px solid #ddd;border-radius:8px;">
                    <strong>Passenger @(i + 1): @Model.Passengers[i].Name</strong> <span style="color:#666;">(Seat @Model.SelectedSeats.First(s => s.SeatId == Model.Passengers[i].SeatId).SeatNumber)</span>
                    <select name="selectedMealIds" class="form-select" style="margin-top:10px;">
                        <option value="">No In-Flight Meal (RM 0.00)</option>
                        @foreach (var meal in Model.Meals) { <option value="@meal.MealId">@meal.MealName (+RM @meal.Price.ToString("N2"))</option> }
                    </select>
                </div>
            }

            <div style="display: flex; gap: 12px; align-items: center; border-top: 1px solid #eee; padding-top: 20px;">
                <button type="submit" class="btn btn-primary" style="background: #28a745; color: #fff; border: none; padding: 12px 24px; border-radius: 6px; font-weight: bold; font-size: 15px; cursor: pointer;">
                    Confirm Booking &amp; Proceed to Checkout &rarr;
                </button>
                <a href="/Home/SelectSeat?flightId=@Model.Flight.FlightId&pax=@Model.Pax" class="btn btn-secondary" style="background: #6c757d; color: #fff; padding: 12px 18px; border-radius: 6px; text-decoration: none; font-size: 14px;">
                    &larr; Back to Seats
                </a>
            </div>
        </form>
    </div>
</div>

<style>
    .meal-card:hover {
        border-color: #007bff !important;
        background: #f8fbff;
    }
</style>
