@using X.PagedList
@model IPagedList<User>

@{
    ViewBag.Title = "Admin | User Management";
}

<!-- Search and Filter Bar -->
<form data-ajax="true"
      data-ajax-update="#target"
      data-ajax-loading="#loader"
      id="f">

    @Html.TextBox("name", "", new { type = "search", autofocus = "", data_trim = "", placeholder = "Search name or email..." })

    <!-- Filter by Role -->
    <label>
        @Html.RadioButton("role", "", true) All
    </label>
    <label>
        @Html.RadioButton("role", "Member") Member
    </label>
    <label>
        @Html.RadioButton("role", "Admin") Admin
    </label>

    <button>Search</button>
    <img src="/images/loader.gif" id="loader" style="display: none; vertical-align: middle;">
</form>

<!-- AJAX Target Container -->
<div id="target">
    <partial name="_UserTable" model="Model" />
</div>

@section foot {
    <script>
        let timer = null;

        // Auto-search on typing (500ms delay)
        $('#name').on('input', e => {
            clearTimeout(timer);
            timer = setTimeout(() => $(e.target.form).submit(), 500);
        });

        // Instant filter when radio button is clicked
        $('[name=role]').on('change', e => {
            $(e.target.form).submit();
        });
    </script>
}
