@model NewPasswordVM

@{
    ViewBag.Title = "Account | New Password";
}

<form class="form" method="post">
    <div asp-validation-summary="ModelOnly"></div>
    <input type="hidden" asp-for="Token">

    <label asp-for="New"></label>
    <input asp-for="New" autofocus>
    <span asp-validation-for="New"></span>

    <label asp-for="Confirm"></label>
    <input asp-for="Confirm">
    <span asp-validation-for="Confirm"></span>

    <section>
        <button>Reset Password</button>
    </section>
</form>