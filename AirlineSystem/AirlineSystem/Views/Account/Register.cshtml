@model RegisterVM

@{
    ViewBag.Title = "Account | Register";
}

<form class="form" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly"></div>

    <div class="form-title">Personal Information</div>

    <label asp-for="Email"></label>
    <input asp-for="Email" autofocus>
    <span asp-validation-for="Email"></span>

    <label asp-for="Password"></label>
    <input asp-for="Password">
    <span asp-validation-for="Password"></span>

    <label asp-for="Confirm"></label>
    <input asp-for="Confirm">
    <span asp-validation-for="Confirm"></span>

    <label asp-for="Name"></label>
    <input asp-for="Name">
    <span asp-validation-for="Name"></span>

    <label asp-for="PhoneNumber"></label>
    <input asp-for="PhoneNumber">
    <span asp-validation-for="PhoneNumber"></span>

    <label asp-for="Photo"></label>
    <div>
        <label class="upload">
            <small>Click or Drag Photo here...</small>
            <input asp-for="Photo" accept="image/jpeg,image/png" hidden>
            <img src="/images/photo.jpg">
        </label>
        <br>
        <button type="button" data-camera>📷 Camera</button>
    </div>
    <span asp-validation-for="Photo"></span>

    <!-- 2️⃣ Travel Information Section -->
    <div class="form-title">Travel Information</div>

    <label asp-for="IC"></label>
    <input asp-for="IC" placeholder="000000-00-0000">
    <span asp-validation-for="IC"></span>

    <label asp-for="PassportNo"></label>
    <input asp-for="PassportNo">
    <span asp-validation-for="PassportNo"></span>

    <label asp-for="PassportExpiry"></label>
    <input asp-for="PassportExpiry">
    <span asp-validation-for="PassportExpiry"></span>

    <section>
        <button>Register</button>
        <button type="reset">Reset</button>
    </section>
</form>

@section foot {
    <script>
        $.validator.setDefaults({ ignore: '' });
    </script>
}
